{
  "api_base": "https://tkbcherry.com/api/agent-helper/v1",
  "token_env": "TKB_AGENT_TOKEN",
  "cpu_workers": 256,
  "poll_wait_seconds": 20,
  "heartbeat_seconds": 5.0,
  "request_timeout_seconds": 35,
  "idle_backoff_seconds": 2.0,
  "solver_timeout_seconds": 1800,
  "max_memory_mb": 1048576,
  "max_request_bytes": 33554432,
  "max_result_bytes": 67108864,
  "max_stderr_bytes": 8388608,
  "max_http_response_bytes": 67108864,
  "retry_attempts": 4,
  "retry_backoff_seconds": 0.5,
  "allow_local_http": false
}
