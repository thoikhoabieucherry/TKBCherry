# Mật khẩu Super Admin. Hãy đổi trước khi dùng dữ liệu thật.
TKB_SUPER_PASSWORD=your-secure-password-here

# Máy chủ web/auth/store cục bộ
TKB_RUST_HOST=127.0.0.1
TKB_RUST_PORT=1010

# Tuỳ chọn: đường dẫn SQLite; mặc định rust_api/tkb_store.db
# TKB_DB_PATH=C:\path\to\tkb_store.db

# Tuỳ chọn: origin được phép gọi API; mặc định * phù hợp chạy cục bộ
# TKB_CORS_ORIGIN=http://127.0.0.1:1010

# Tuỳ chọn: 1 để ẩn log yêu cầu
TKB_NO_LOGS=0
