# Super admin password — bắt buộc trên môi trường production
TKB_SUPER_PASSWORD=your-secure-password-here

# Tuỳ chọn: giới hạn CORS origin khi deploy public (mặc định * cho local)
# TKB_CORS_ORIGIN=https://your-domain.com

# Rust API
TKB_RUST_HOST=127.0.0.1
TKB_RUST_PORT=1010
TKB_SOLVER_MAX_CONCURRENT=3
TKB_SOLVER_CPU_TOKENS=6
TKB_SOLVER_MIN_WORKERS=2
TKB_SOLVER_MAX_WORKERS=6
TKB_SOLVER_REQUIRE_AUTH=1
