# Sao chép file này thành .env rồi điền thông tin Gmail của bạn

# Địa chỉ Gmail dùng để gửi (ví dụ: truong.tkb@gmail.com)
GMAIL_USER=your-email@gmail.com

# App Password 16 ký tự tạo trong Google (KHÔNG phải mật khẩu đăng nhập Gmail)
# Xem hướng dẫn tạo trong README.md
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Tên hiển thị người gửi
FROM_NAME=Thời khóa biểu

# Cổng chạy server (mặc định 8787)
PORT=8787

# Các origin web được phép gọi mail API, phân tách bằng dấu phẩy.
TKB_CORS_ORIGIN=https://tkbcherry.com,https://www.tkbcherry.com,http://127.0.0.1:1010,http://localhost:1010

# Giới hạn gửi OTP trong mỗi cửa sổ 15 phút.
OTP_RATE_WINDOW_MS=900000
OTP_MAX_PER_IP=20
OTP_MAX_PER_EMAIL=5
